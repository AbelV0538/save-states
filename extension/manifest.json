{
  "manifest_version": 3,
  "name": "Save States Companion",
  "version": "0.1.0",
  "description": "Lets the Save States desktop app save and restore the tabs open in this Chrome profile.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "sw.js" },
  "permissions": ["tabs", "tabGroups", "nativeMessaging", "alarms", "storage"]
}
